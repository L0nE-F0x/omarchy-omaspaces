{
  "schemaVersion": 1,
  "id": "lonefox.omaspaces",
  "name": "OmaSpaces",
  "version": "1.0.0",
  "author": "lonefox",
  "license": "MIT",
  "description": "Workspace profiles for the Omarchy bar. Pick \"At Work\" and every app you keep for work opens on the workspace you keep it on.",
  "keywords": ["workspaces", "profiles", "layout", "session", "launcher", "hyprland"],
  "kinds": ["bar-widget"],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "OmaSpaces",
    "description": "Workspace profiles. Left click opens the list, right click re-applies the last space you picked.",
    "category": "Workspaces",
    "allowMultiple": false,
    "defaultSection": "left",
    "defaults": {
      "autoClose": true,
      "maxWorkspace": 10
    },
    "schema": [
      {
        "key": "autoClose",
        "type": "boolean",
        "label": "Close the panel once a space is ready",
        "defaultValue": true
      },
      {
        "key": "maxWorkspace",
        "type": "integer",
        "label": "Highest workspace number offered",
        "min": 1,
        "max": 30,
        "step": 1,
        "defaultValue": 10
      }
    ]
  }
}
